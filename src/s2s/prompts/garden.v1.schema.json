{
  "type": "object",
  "required": ["propose_label", "merge_labels"],
  "properties": {
    "propose_label": {
      "type": ["object", "null"],
      "required": ["name", "gist", "examples", "evidence_incident_ids"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "gist": {"type": "string"},
        "examples": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 3},
        "evidence_incident_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 3}
      }
    },
    "merge_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["survivor", "absorbed", "reason"],
        "properties": {
          "survivor": {"type": "string", "enum": []},
          "absorbed": {"type": "string", "enum": []},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
